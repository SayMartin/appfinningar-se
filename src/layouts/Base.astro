---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, routes, type Lang, type RouteKey } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  current: RouteKey;
  title: string;
  description: string;
}

const { lang, current, title, description } = Astro.props;
const tr = t(lang);

const canonical = new URL(routes[current][lang], Astro.site);
const svUrl = new URL(routes[current].sv, Astro.site);
const enUrl = new URL(routes[current].en, Astro.site);
---

<!doctype html>
<html lang={lang === 'sv' ? 'sv-SE' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Berättar för Google att sidorna är översättningar av varandra och inte
       dubblettinnehåll. x-default pekar på svenska, som är rot-URL:en. -->
  <link rel="alternate" hreflang="sv" href={svUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={svUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={tr('site.name')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>

<body>
  <a class="skip" href="#main">{tr('nav.skipToContent')}</a>

  <div class="wrap">
    <Header lang={lang} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </div>
</body>
</html>
