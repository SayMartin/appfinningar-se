---
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const tr = t(lang);

// One card points at this very site. A "visit the site" link there would take
// the reader nowhere, so it is left out — the host line still names the
// address. Derived from the URL rather than a flag on the project, so it can
// never fall out of sync with what the card actually links to.
const isThisSite = Astro.site && project.url === Astro.site.href;
---

<article class="card glass">
  <h3>
    <a href={project.url}>{project.name}</a>
    {project.tag && <span class="tag">{project.tag[lang]}</span>}
  </h3>

  <p>{project.description[lang]}</p>
  <p class="stack">{project.stack[lang]}</p>

  <p class="links">
    {!isThisSite && <a href={project.url}>{tr('projects.visit')}</a>}
    {project.repo && <a href={project.repo}>{tr('projects.source')}</a>}
    <span class="host">{project.host}</span>
  </p>
</article>

<style>
  /* No hover state on the card itself. Only the links inside it respond to a
     pointer, and a card that lifts and lights up under one promises a click
     target that is not there. */
  .card {
    position: relative;
    padding: 1.5rem 1.6rem;
  }
  /* Faint glow under the card, lit all the time rather than on hover: the
     cards are not clickable, so an effect that only appears under the pointer
     would be a reward for pointing at something that does not respond. Sits
     behind the card (z-index: -1) so it can never cover the text. */
  .card::after {
    content: ''; position: absolute; inset: -1px; border-radius: inherit;
    z-index: -1;
    box-shadow: 0 14px 40px -14px rgba(61, 139, 253, .45);
  }
  h3 { margin: 0 0 .4rem; font-size: 1.18rem; letter-spacing: -.01em; }
  h3 a { color: var(--accent); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0 0 .6rem; color: var(--muted); font-size: .96rem; }
  /* Smaller and dimmer than the description, and set off by a rule: the card
     reads as "what it does" first, "how it is built" second, rather than as two
     paragraphs competing for the same attention. */
  .stack {
    font-size: .88rem; opacity: .78;
    margin-top: .9rem; padding-top: .8rem;
    border-top: 1px solid var(--border);
  }
  /* The gap only has to separate two links when a card carries both; the
     host is pushed to the far end by its own auto margin either way. */
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .9rem; margin-bottom: 0; }
  .links a { font-size: .9rem; }
  .host {
    margin-left: auto; font-size: .84rem; opacity: .75;
    font-variant-numeric: tabular-nums;
  }
</style>
