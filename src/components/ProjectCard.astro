---
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const tr = t(lang);
---

<article class="card glass">
  <h3>
    <a href={project.url}>{project.name}</a>
    {project.tag && <span class="tag">{project.tag[lang]}</span>}
  </h3>

  <p>{project.description[lang]}</p>

  <p class="links">
    <a href={project.url}>{tr('projects.visit')}</a>
    <span class="host">{project.host}</span>
  </p>
</article>

<style>
  .card {
    position: relative;
    padding: 1.5rem 1.6rem;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .card:hover {
    background: var(--surface-hov);
    border-color: var(--border-hov);
    transform: translateY(-3px);
  }
  /* Svag glöd som tänds under kortet vid hovring. Ligger bakom (z-index: -1)
     så den aldrig lägger sig över texten. */
  .card::after {
    content: ''; position: absolute; inset: -1px; border-radius: inherit;
    z-index: -1; opacity: 0; transition: opacity .25s ease;
    box-shadow: 0 14px 40px -14px rgba(61, 139, 253, .45);
  }
  .card:hover::after { opacity: 1; }
  h3 { margin: 0 0 .4rem; font-size: 1.18rem; letter-spacing: -.01em; }
  h3 a { color: var(--accent); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0 0 .6rem; color: var(--muted); font-size: .96rem; }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem; margin-bottom: 0; }
  .links a { font-size: .9rem; }
  .host {
    margin-left: auto; font-size: .84rem; opacity: .75;
    font-variant-numeric: tabular-nums;
  }
</style>
