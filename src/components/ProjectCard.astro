---
import { t, type Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const tr = t(lang);
---

<article class="card">
  <h3>
    <a href={project.url}>{project.name}</a>
    {project.tag && <span class="tag">{project.tag[lang]}</span>}
  </h3>

  <p>{project.description[lang]}</p>

  <p class="links">
    <a href={project.url}>{tr('projects.visit')}</a>
    {project.repo && (
      <>
        <span class="sep">·</span>
        <a href={project.repo} rel="noopener">{tr('projects.repo')}</a>
      </>
    )}
    <span class="host">{project.host}</span>
  </p>
</article>

<style>
  .card {
    padding: 1.4rem 1.5rem; margin-bottom: 1rem;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color .15s ease, transform .15s ease;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  h3 { margin: 0 0 .4rem; font-size: 1.18rem; letter-spacing: -.01em; }
  h3 a { color: var(--accent); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0 0 .6rem; color: var(--muted); font-size: .96rem; }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem; margin-bottom: 0; }
  .links a { font-size: .9rem; }
  .sep { margin: 0 .5rem; opacity: .5; }
  .host {
    margin-left: auto; font-size: .84rem; opacity: .75;
    font-variant-numeric: tabular-nums;
  }
</style>
