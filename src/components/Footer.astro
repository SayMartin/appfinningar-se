---
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer>
  <h2 class="fine">&copy; {year} {tr('footer.holder')}  <a href="https://appfinningar.se" rel="me">appfinningar.se</a></h2>
</footer>

<style>
  footer {
    margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    font-size: .9rem; color: var(--muted);
  }
  footer p { margin: 0 0 .4rem; }
  .fine { font-size: .84rem; opacity: .8; }
</style>
