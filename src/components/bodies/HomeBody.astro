---
import ProjectCard from '../ProjectCard.astro';
import PhotoGrid from '../PhotoGrid.astro';
import { t, routes, type Lang } from '../../i18n/ui';
import { projects } from '../../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<div class="intro">
  <p class="avail"><span class="badge">{tr('contact.available')}</span></p>
  <h1>{tr('home.h1')}</h1>
  <p class="lede measure">{tr('home.lede')}</p>

  <div class="btn-row">
    <a class="btn btn-primary" href={`#${tr('projects.heading').toLowerCase()}`}>{tr('projects.heading')}</a>
    <a class="btn btn-ghost" href={routes.about[lang]}>{tr('about.readMore')}</a>
  </div>
</div>

<h2 class="section-heading" id={tr('projects.heading').toLowerCase()}>{tr('projects.heading')}</h2>
<div class="card-grid">
  {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
</div>

<h2 class="section-heading">{tr('photos.heading')}</h2>
<p class="lede measure center photo-lede">{tr('photos.lede')}</p>
<PhotoGrid lang={lang} limit={6} />
<p class="more center"><a href={routes.photos[lang]}>{tr('photos.seeAll')} &rarr;</a></p>

<h2 class="section-heading">{tr('about.heading')}</h2>
<p class="lede measure center">{tr('contact.lede')}</p>
<div class="btn-row center-row">
  <a class="btn btn-primary" href={routes.about[lang]}>{tr('about.readMore')}</a>
  <a class="btn btn-ghost" href="mailto:martin@appfinningar.se">{tr('contact.email')}</a>
</div>

<style>
  .intro { margin: 1rem 0 1rem; }
  .avail { margin: 0 0 1.4rem; }
  .photo-lede { margin-bottom: 1.6rem; }
  .more { margin-top: 1.4rem; font-size: .95rem; }
  .center-row { justify-content: center; }
</style>
