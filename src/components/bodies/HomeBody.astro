---
import ProjectCard from '../ProjectCard.astro';
// import PhotoGrid from '../PhotoGrid.astro';  // photo section is off on the home page
import { t, routes, type Lang } from '../../i18n/ui';
import { projects } from '../../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<div class="intro">
  <p class="avail"><span class="badge">{tr('contact.available')}</span></p>
  <h1>
    <span>{tr('home.h1')}</span>
    <span>{tr('home.h1.line2')}</span>
  </h1>
  <p class="lede measure">{tr('home.lede')}</p>

  <div class="btn-row">
    <a class="btn btn-primary" href={`#${tr('projects.heading').toLowerCase()}`}>{tr('projects.heading')}</a>
    <a class="btn btn-ghost" href={routes.about[lang]}>{tr('about.readMore')}</a>
  </div>
</div>

<h2 class="section-heading" id={tr('projects.heading').toLowerCase()}>{tr('projects.heading')}</h2>
<div class="card-grid">
  {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
</div>

{/* The photo section is not shown on the home page right now. The photo pages
    still exist and work — uncomment the block below and the import at the top
    to bring it back. This is a {}-style comment on purpose: a plain HTML
    comment would ship out in the delivered page.

<h2 class="section-heading">{tr('photos.heading')}</h2>
<p class="lede measure center photo-lede">{tr('photos.lede')}</p>
<PhotoGrid lang={lang} limit={6} />
<p class="more center"><a href={routes.photos[lang]}>{tr('photos.seeAll')} &rarr;</a></p>
*/}

<h2 class="section-heading">{tr('about.heading')}</h2>
<p class="lede measure">{tr('contact.lede')}</p>
<div class="btn-row measure">
  <a class="btn btn-primary" href={routes.about[lang]}>{tr('about.readMore')}</a>
  <a class="btn btn-ghost" href="mailto:martin@appfinningar.se">{tr('contact.email')}</a>
</div>

<style>
  /* Centred as a column, not as text. The cap sits on the wrapper rather than
     on each child, so the badge, the heading, the lede and the buttons all
     start at the same left edge instead of each finding its own. */
  .intro { max-width: var(--measure); margin: 1rem auto; }
  /* The heading is the exception, centred like every other heading on the
     site — the text under it stays left-aligned. The two lines are spans set
     to block rather than a <br>, so the break is a layout decision the
     stylesheet owns and each half stays one selectable unit. */
  .intro h1 { text-align: center; }
  .intro h1 span { display: block; }
  .avail { margin: 0 0 1.4rem; }
  .photo-lede { margin-bottom: 1.6rem; }
  .more { margin-top: 1.4rem; font-size: .95rem; }
</style>
