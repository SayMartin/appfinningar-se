---
import PhotoGrid from '../PhotoGrid.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<h1>{tr('photos.heading')}</h1>
<p class="lede">{tr('photos.lede')}</p>

<div class="gallery">
  <PhotoGrid lang={lang} />
</div>

<style>
  /* Same as the other pages: the heading shares the lede's column so the two
     line up on the left instead of starting in different places. */
  h1 { max-width: var(--measure); margin-inline: auto; text-align: center; }

  .gallery { margin-top: 2.5rem; }
</style>
