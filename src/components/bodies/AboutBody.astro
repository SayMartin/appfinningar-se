---
import { Image } from 'astro:assets';
import portrait from '../../assets/martin_foto.jpeg';
import { t, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

// Prose that only exists on this page is kept here rather than in ui.ts —
// ui.ts is for short recurring labels, not whole paragraphs.
const copy = {
  sv: {
    intro:
      'Jag heter Martin och bygger webbtjänster och mobilappar. Appfinningar är domänen jag samlar dem under, inget företag. Det som ligger under Projekt är inte skisser eller kursuppgifter — det är saker som är i drift och går att klicka sig in i och prova.',
    portraitAlt: 'Martin, med glasögon och blårutig skjorta, framför en kvällshimmel.',
    workHeading: 'Vad jag arbetar med',
    skills: [
      { label: 'Språk', items: 'TypeScript, C#, Kotlin, Java, Swift, Dart, SQL' },
      { label: 'Mobil', items: 'Android och iOS nativt, Flutter, MVVM, Android Studio och Xcode' },
      { label: 'Frontend', items: 'React, Next.js, React Native/Expo, Tailwind' },
      { label: 'Backend', items: '.NET, Entity Framework, Postgres, Prisma, Drizzle, Supabase, Cloudflare D1' },
      { label: 'Drift', items: 'Docker, GitHub Actions, Cloudflare Workers/Pages/R2/Tunnel, nginx, egen Ubuntu-server' },
    ],
    work: [
      'Jag är utbildad mobilutvecklare och har arbetat som det. Yrkeshögskola i iOS- och Android-programmering i Malmö, sedan flera år i produktion: ett frilansuppdrag som ensam apputvecklare i Flutter, och därefter Bayou i Lund som en av två utvecklare på Android-sidan av TYRA Förskoleappen — en kodbas som över 2 500 förskolor loggar in i. Mobilen är alltså inte något jag provat vid sidan om, det är där jag kommer ifrån.',
      'Sedan dess har jag breddat mig, och det är åt det hållet jag söker mig vidare: hela kedjan i stället för ett lager av den. Tyngdpunkten ligger numera i TypeScript och .NET, och mina egna projekt på förstasidan är designade, byggda och driftsatta av mig ensam — från datamodell till maskinen de står på. Mobilvanan följer med snarare än ersätts; Wordlune är en enda kodbas som blir iOS, Android och webb samtidigt.',
    ],
    workPreference: 'Helst fullstack i TypeScript, gärna med mobilen i samma kodbas.',
    backgroundHeading: 'Bakgrund',
    background: [
      'Jag läste fysik i Lund men tog aldrig ut någon examen. Examensarbetet — experimentell molekylär elektronik på nanoavdelningen — blev aldrig presenterat: att forska och undervisa var roligare än att skriva klart, och när pengarna tog slut fick jag ta ett jobb. Det jobbet blev begravningsentreprenör, och där blev jag kvar i tretton år — de sista tre på byråns familjerättsavdelning som juristassistent inom familjerätt. Det är inte den bakgrund som brukar stå på en utvecklares sida, men det är två yrken där noggrannhet och möten med människor i utsatta lägen är själva arbetet.',
      'Vägen in i utveckling gick via mobilen: yrkeshögskoleutbildning i iOS- och Android-programmering i Malmö, praktik på Cybercom med en röststyrd prototyp i Android, ett frilansuppdrag åt Head of Search som ensam apputvecklare i Flutter, och därefter knappt tre år på Bayou i Lund som en av två utvecklare på Android-sidan av TYRA Förskoleappen — en kodbas som började i Java och växte vidare i Kotlin.',
      'Efter Bayou lade jag om kursen. Nyfikenhet och vetgirighet driver mig att utforska nya områden, och jag ville bredda mig från Android-specialisten till ett mer projektövergripande ansvar: från idé till färdig produkt, med kundnyttan i centrum och med någon som värnar om idén hela vägen dit. Hösten 2025 började jag därför en fullstackutbildning på Lexicon i Malmö för att lägga backend och webb till mobilen — C#, .NET, Entity Framework och SQL, React och TypeScript — och läste parallellt en distanskurs i agila metoder för utvecklare på Lexicon i Stockholm.',
    ],
    placement: {
      before: 'Praktiken gjorde jag på ',
      link: 'Munka Folkhögskola',
      after:
        ', där jag byggde skolans nya webbplats i Next.js och ersatte en äldre WordPress-lösning. Hela kodbasen är skriven av mig, och sajten är i drift. Det bygget blev också utgångspunkten för School CMS: det jag lärde mig av en riktig skolas behov generaliserade jag till ett system som inte är bundet till en enda skola.',
    },
    backgroundClosing:
      'Sedan dess bygger jag vidare på egen hand. Servern som ett par av projekten här ovan står på är en ombyggd MacBook Pro från 2016 som numera kör Ubuntu, Docker och Cloudflare Tunnel — billigaste sättet jag hittade att lära mig drift på riktigt i stället för i en handledning.',
    contactHeading: 'Kontakt',
    availability:
      'Jag utgår från Malmö och arbetar på plats, på distans eller hybrid. Finns rätt sammanhang någon annanstans flyttar jag gärna dit. Uppdrag fakturerar jag via eget bolag — frilans, korta som långa. Anställning är lika intressant.',
    onRequest: 'CV och referenser lämnar jag gärna på förfrågan.',
  },
  en: {
    intro:
      'I am Martin, and I build web services and mobile apps. Appfinningar is the domain I keep them on, not a company. What sits under Projects are not sketches or coursework — they are running, and you can click in and try them.',
    portraitAlt: 'Martin, in glasses and a blue checked shirt, against an evening sky.',
    workHeading: 'What I work with',
    skills: [
      { label: 'Languages', items: 'TypeScript, C#, Kotlin, Java, Swift, Dart, SQL' },
      { label: 'Mobile', items: 'Native Android and iOS, Flutter, MVVM, Android Studio and Xcode' },
      { label: 'Frontend', items: 'React, Next.js, React Native/Expo, Tailwind' },
      { label: 'Backend', items: '.NET, Entity Framework, Postgres, Prisma, Drizzle, Supabase, Cloudflare D1' },
      { label: 'Operations', items: 'Docker, GitHub Actions, Cloudflare Workers/Pages/R2/Tunnel, nginx, my own Ubuntu server' },
    ],
    work: [
      'I trained as a mobile developer and have worked as one. A vocational programme in iOS and Android development in Malmö, then several years in production: a freelance assignment as the sole app developer in Flutter, and after that Bayou in Lund as one of two developers on the Android side of the TYRA preschool app — a codebase more than 2,500 preschools log into. Mobile is not something I tried on the side; it is where I come from.',
      'Since then I have widened out, and that is the direction I am looking to go further in: the whole chain rather than one layer of it. The weight now sits in TypeScript and .NET, and my own projects on the front page were designed, built and deployed by me alone — from data model to the machine they run on. The mobile habit comes along rather than being replaced; Wordlune is a single codebase that becomes iOS, Android and web at once.',
    ],
    workPreference: 'Fullstack in TypeScript for preference, ideally with mobile in the same codebase.',
    backgroundHeading: 'Background',
    background: [
      'I read physics at Lund but never took a degree. The thesis work — experimental molecular electronics at the nano department — was never presented: doing research and teaching was more fun than writing it up, and when the money ran out I had to take a job. That job turned out to be funeral director, and I stayed for thirteen years — the last three in the firm’s family law department as a paralegal working in family law. It is not the background that usually appears on a developer’s page, but they are two jobs where precision and meeting people at their most vulnerable are the work itself.',
      'The way into development went through mobile: a vocational programme in iOS and Android development in Malmö, an internship at Cybercom building a voice-controlled prototype on Android, a freelance assignment for Head of Search as the sole app developer in Flutter, and then close to three years at Bayou in Lund as one of two developers on the Android side of the TYRA preschool app — a codebase that started in Java and grew on in Kotlin.',
      'After Bayou I changed course. Curiosity is what drives me into new territory, and I wanted to widen out from the Android specialist into responsibility across a whole project: from idea to finished product, with the value to the customer at the centre and someone looking after the idea the whole way there. So in the autumn of 2025 I started a fullstack programme at Lexicon in Malmö to add backend and web to the mobile side — C#, .NET, Entity Framework and SQL, React and TypeScript — alongside a distance course in agile methods for developers at Lexicon in Stockholm.',
    ],
    placement: {
      before: 'I did my placement at ',
      link: 'Munka Folkhögskola',
      after:
        ', building the school’s new website in Next.js to replace an older WordPress one. The entire codebase is mine, and the site is live. That build also became the starting point for School CMS: what I learned from one real school’s needs I generalised into a system that is not tied to any single school.',
    },
    backgroundClosing:
      'Since then I have carried on by myself. The server a couple of the projects above run on is a repurposed 2016 MacBook Pro now running Ubuntu, Docker and Cloudflare Tunnel — the cheapest way I found to learn operations for real rather than in a tutorial.',
    contactHeading: 'Contact',
    availability:
      'I am based in Malmö and work on site, remotely or hybrid. If the right place is somewhere else, I will gladly move there. Assignments are invoiced through my own company — freelance, short or long. Employment is just as interesting.',
    onRequest: 'A CV and references are gladly provided on request.',
  },
}[lang];
---

<h1>{tr('about.heading')}</h1>

<div class="portrait-frame">
  <Image
    class="portrait"
    src={portrait}
    alt={copy.portraitAlt}
    width={160}
    densities={[1, 2]}
    format="webp"
    quality={80}
  />
</div>

<div class="prose">
  <p class="lede">{copy.intro}</p>

  <h2 class="section-heading">{copy.workHeading}</h2>
  <ul class="skills">
    {copy.skills.map(({ label, items }) => (
      <li><strong>{label}:</strong> {items}</li>
    ))}
  </ul>
  {copy.work.map((paragraph) => <p>{paragraph}</p>)}
  <p class="preference">{copy.workPreference}</p>

  <h2 class="section-heading">{copy.backgroundHeading}</h2>
  {copy.background.map((paragraph) => <p>{paragraph}</p>)}
  <p>
    {copy.placement.before}<a href="https://www.munkafolkhogskola.se/">{copy.placement.link}</a>{copy.placement.after}
  </p>
  <p>{copy.backgroundClosing}</p>

  <h2 class="section-heading">{copy.contactHeading}</h2>
  <p>{copy.availability}</p>
  <p>{copy.onRequest}</p>
  <div class="btn-row measure">
    <a class="btn" href="mailto:martin@appfinningar.se">{tr('contact.email')}</a>
  </div>
</div>

<style>
  /* The heading sits outside .prose, so it needs the same cap and auto margins
     as the paragraphs below it — otherwise it starts at the page edge while
     they start in the middle. Centred like the section headings; only the
     running text stays left-aligned. */
  h1 { max-width: var(--measure); margin-inline: auto; text-align: center; }

  .portrait-frame {
    position: relative;
    width: 10rem; height: 10rem;
    margin: 0 auto 2rem;
  }

  /* The halo: a larger disc of the brand gradient, blurred, behind the photo.
     Both layers are positioned with non-negative z-index on purpose. A
     z-index: -1 disc would disappear: html carries its own background, so
     body's background is painted as an ordinary element background — which
     sits above every negative-z-index descendant, halo included. */
  .portrait-frame::before {
    content: '';
    position: absolute; inset: -9%;
    z-index: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    filter: blur(12px);
    opacity: .6;
  }

  /* Round on purpose. The source is cropped out of a group photo, so the
     corners still hold a stranger's hair and something red — a circle removes
     both without touching the file. object-fit keeps the face centred whatever
     the source aspect happens to be. */
  .portrait {
    display: block;
    position: relative; z-index: 1;
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .skills { margin-bottom: 1.4rem; }

  /* The one line that decides which jobs get in touch, so it is lifted out of
     the muted body colour instead of closing the section as another grey
     sentence. */
  .preference { color: var(--text); font-size: 1.05rem; }
</style>
